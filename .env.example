# Copy to .env.local and fill in. Only NEXT_PUBLIC_ values are ever visible to the browser.

# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key: safe for the browser, but currently unused (all DB access is server-side; RLS blocks it)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Secret key: SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=your-secret-or-service-role-key

# Google AI Studio -> API keys
GEMINI_API_KEY=your-gemini-api-key
# Optional: override the model (defaults to the current stable Flash model)
GEMINI_MODEL=gemini-3.8-flash

# Resend -> API keys. EMAIL_FROM must use a domain verified in Resend
# (onboarding@resend.dev only delivers to your own Resend account email).
RESEND_API_KEY=re_your_key
EMAIL_FROM=Kargo Hiring <onboarding@resend.dev>

# Optional
FOUNDER_NAME=The Kargo Founding Team
# Score (0-100) on the applied role at/above which a candidate gets an interview invite
SHORTLIST_THRESHOLD=40
